# Cloudflare Pages headers. The CSP allows only this origin and the kit.
# Apps that need more (atproto, a local model) add origins to connect-src.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://kit.thatsit.app; style-src 'self' 'unsafe-inline' https://kit.thatsit.app; font-src https://kit.thatsit.app; img-src 'self' data: blob:; connect-src 'self' https://kit.thatsit.app; manifest-src 'self'; worker-src 'self'; base-uri 'none'; form-action 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Hashed file names, so they never change. Pages merges matching blocks, so /* still applies here.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
